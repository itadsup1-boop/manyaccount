# ═══════════════════════════════════════════
#  Facebook News Auto Remix Pipeline - Config
# ═══════════════════════════════════════════

# Supabase
SUPABASE_URL=https://iynwmytfroatvzhbkodf.supabase.co
SUPABASE_KEY=your_supabase_key_here

# Google APIs
GOOGLE_SHEET_ID=your_google_sheet_id_here
DRIVE_FOLDER_ID=your_drive_folder_id_here

# AI - Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Voicebox TTS
VOICEBOX_API_KEY=vbox_your_api_key_here
VOICEBOX_URL=http://127.0.0.1:8080/generate/full-pipeline
VOICEBOX_PROFILE_ID=d4dbf9de-2f6a-42e7-8f8d-0e5586824a21

# Pipeline Settings
SCAN_INTERVAL_MINUTES=30
MAX_CONCURRENT_JOBS=3
# Pipeline bài báo: đủ 5 video thành công thì chuyển sang profile kế tiếp.
ARTICLE_SUCCESS_BATCH_SIZE=5
# 0 = chạy đồng thời tất cả kênh; số dương = giới hạn số worker kênh.
ARTICLE_MAX_CHANNEL_WORKERS=0
MAX_RETRY_COUNT=3

# TikTok sources are manually approved by the operator; set to 1 only when
# the AI topic-fit gate should be enforced again.
TIKTOK_TOPIC_GATE=0

# Nguồn TikTok: quét và tải ngầm qua ClipSaver, tối đa 3 video mỗi kênh.
TIKTOK_CLIPSSAVER_TIMEOUT_MS=90000
TIKTOK_CLIPSSAVER_DOWNLOAD_TIMEOUT_MS=120000
# Luồng tải cũ TikWM/RapidAPI/yt-dlp được giữ lại nhưng mặc định tắt.
TIKTOK_LEGACY_SOURCE_ENABLED=false

# Controlled experiments and per-channel learning (safe opt-in)
CONTENT_EXPERIMENTS_ENABLED=0
PERFORMANCE_LEARNING_ENABLED=0
