{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Media Article JSON v1",
  "type": "object",
  "required": ["schema_version", "source_type", "source_url", "fact_sheet", "story_type", "title_tiktok", "main_idea", "main_angle", "audience_payoff", "hook_variants", "selected_hook", "selected_hook_reason", "hook", "script_voice", "curiosity_point", "viewer_emotion", "should_make_video", "tone", "music_mood", "music_energy", "is_sensitive", "music_reason", "topic_fit", "topic_fit_reason", "quality_score", "skip_reason", "claim_register", "evidence", "beats", "retention_risks", "risk_flags"],
  "properties": {
    "schema_version": {"const": 1},
    "source_type": {"const": "article"},
    "source_url": {"type": "string", "pattern": "^https?://[^\\s\\[\\]\\(\\)]+$"},
    "fact_sheet": {"type": "object", "required": ["who", "what", "when", "where", "cause", "impact", "confirmed_facts", "unknowns"]},
    "story_type": {"type": "string"},
    "title_tiktok": {"type": "string"},
    "main_idea": {"type": "string"},
    "main_angle": {"type": "string"},
    "audience_payoff": {"type": "string"},
    "hook_variants": {"type": "array", "minItems": 3, "maxItems": 3},
    "selected_hook": {"type": "string"},
    "selected_hook_reason": {"type": "string"},
    "hook": {"type": "string"},
    "script_voice": {"type": "string"},
    "curiosity_point": {"type": "string"},
    "viewer_emotion": {"type": "string"},
    "should_make_video": {"type": "boolean"},
    "tone": {"type": "string"},
    "music_mood": {"type": "string"},
    "music_energy": {"type": "integer", "minimum": 1, "maximum": 3},
    "is_sensitive": {"type": "boolean"},
    "music_reason": {"type": "string"},
    "topic_fit": {"type": "boolean"},
    "topic_fit_reason": {"type": "string"},
    "quality_score": {"type": "integer", "minimum": 1, "maximum": 10},
    "skip_reason": {"type": "string"},
    "claim_register": {"type": "array"},
    "evidence": {"type": "array"},
    "beats": {"type": "array", "minItems": 7, "maxItems": 9, "items": {"type": "object", "required": ["beat_number", "role", "duration_hint", "voice_over", "visual_query", "on_screen_text", "motion", "transition", "sfx", "must_show"], "properties": {"beat_number": {"type": "integer", "minimum": 1}, "role": {"type": "string"}, "duration_hint": {"type": "number", "minimum": 2, "maximum": 8}, "voice_over": {"type": "string"}, "visual_query": {"type": "string", "minLength": 8}, "asset_search_queries": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"type": "string", "minLength": 8}}, "visual_brief": {"type": "string", "minLength": 20}, "visual_fallback": {"type": "string"}, "required_country": {"type": "string", "minLength": 2}, "country_strict": {"type": "boolean"}, "on_screen_text": {"type": "string"}, "motion": {"enum": ["static", "slow_push_in", "slow_pull_out", "pan_left", "pan_right"]}, "transition": {"enum": ["cut", "fade"]}, "sfx": {"type": "string"}, "must_show": {"type": "array"}}}},
    "retention_risks": {"type": "array"},
    "risk_flags": {"type": "array"}
  }
}
